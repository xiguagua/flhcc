---
import Link from "@components/Link.astro";
import { SITE } from "@consts";
---

<header>
  <div class="rounded-sm bg-[#eee7db] px-5 py-5 shadow-[0_0_0_1px_rgb(238_231_219_/_0.14)] sm:px-8 md:px-14">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-3 uppercase tracking-[0.24em] text-[#85796b] dark:text-[#85796b]">
      <Link href="/" underline={false}>
        <div class="font-semibold text-[#080706] dark:text-[#080706]">
          {SITE.NAME}
        </div>
      </Link>
      <Link href={`mailto:${SITE.EMAIL}`} aria-label={`Email ${SITE.NAME}`} underline={false}>
        {SITE.EMAIL}
      </Link>
    </div>
  </div>
</header>
