---
import Link from "@components/Link.astro";
import { SITE } from "@consts";
---

<header>
  <div class="px-5 py-5 sm:px-8 md:px-14">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-3 uppercase tracking-[0.24em] text-[var(--muted)] dark:text-[var(--muted)]">
      <Link href="/" underline={false}>
        <div class="font-semibold text-[var(--ink)] dark:text-[var(--ink)]">
          {SITE.NAME}
        </div>
      </Link>
      <Link href={`mailto:${SITE.EMAIL}`} aria-label={`Email ${SITE.NAME}`} underline={false}>
        {SITE.EMAIL}
      </Link>
    </div>
  </div>
</header>
