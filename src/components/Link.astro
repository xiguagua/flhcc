---
import { cn } from "@lib/utils";

type Props = {
  href: string;
  external?: boolean;
  underline?: boolean;
}

const { href, external, underline = true, ...rest } = Astro.props;
---

<a 
  href={href} 
  target={ external ? "_blank" : "_self" } 
  class={cn("inline-block decoration-[#080706]/25 dark:decoration-[#080706]/30 hover:decoration-[#080706]/60 hover:dark:decoration-[#080706]/65 text-current hover:text-[#080706] hover:dark:text-[#080706] transition-colors duration-300 ease-in-out", underline && "underline underline-offset-4")}
  {...rest}>
  <slot/>
</a>
