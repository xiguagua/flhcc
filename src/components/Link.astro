---
import { cn } from "@lib/utils";

type Props = {
  href: string;
  external?: boolean;
  underline?: boolean;
}

const { href, external, underline = true, ...rest } = Astro.props;
---

<a 
  href={href} 
  target={ external ? "_blank" : "_self" } 
  class={cn("inline-block decoration-accent/35 hover:decoration-accent/75 text-current hover:text-accent transition-colors duration-300 ease-in-out", underline && "underline underline-offset-4")}
  {...rest}>
  <slot/>
</a>
