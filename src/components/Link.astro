---
import { cn } from "@lib/utils";

type Props = {
  href: string;
  external?: boolean;
  underline?: boolean;
}

const { href, external, underline = true, ...rest } = Astro.props;
---

<a 
  href={href} 
  target={ external ? "_blank" : "_self" } 
  class={cn("inline-block decoration-[#24211d]/20 dark:decoration-[#eee6d8]/25 hover:decoration-[#24211d]/50 hover:dark:decoration-[#eee6d8]/60 text-current hover:text-[#17130f] hover:dark:text-[#fff7e8] transition-colors duration-300 ease-in-out", underline && "underline underline-offset-4")}
  {...rest}>
  <slot/>
</a>
