---
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import ArrowCard from "@components/ArrowCard.astro";
import { SITE, HOME } from "@consts";
import { getPublished } from "@lib/content";

const apps = (await getPublished("apps"))
  .slice(0, SITE.NUM_PROJECTS_ON_HOMEPAGE);
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <div class="space-y-16">
      <section>
        <p class="animate mb-5 text-xs font-semibold uppercase tracking-[0.22em] text-[#6d6257] dark:text-[#b9ab98]">
          Independent iOS Studio // Flhcc Tech
        </p>
        <h1 class="animate font-serif text-5xl font-semibold leading-[1.05] tracking-[-0.06em] text-[#17130f] dark:text-[#fff7e8] md:text-7xl">
          Native tools for Apple devices.
        </h1>
        <article class="mt-10 space-y-4 text-lg leading-8 md:text-xl md:leading-9">
          <p class="animate">
            I’m an independent iOS developer and founder of <b>Flhcc Tech</b>.
          </p>
          <p class="animate">
            I build native apps for <strong>Apple devices</strong>, focusing on <strong
              >networking protocols</strong
            >, <strong>system security</strong>, and <strong
              >company equity analysis</strong
            >.
          </p>
          <p class="animate">
            Currently working on <strong>Bamboo Dragonfly</strong>.
          </p>
        </article>
      </section>
      <!-- <p class="animate">
            I come packed with full type safety, a sitemap, an rss feed, markdown 
            and mdx support (use components in your markdown) through astro integrations.
            I am styled with tailwind and come preconfigured with light, dark and 
            system/os theme preferences out of the box.
          </p>
          <p class="animate">
            Visit
            <Link href="https://github.com/markhorn-dev/astro-nano" aria-label="Astro Nano on Github" external>
              Astro Nano on Github
            </Link>
            to fork the repository, read the docs or one-click deploy on Vercel or Netlify. 
          </p> -->
    </div>

    <section class="animate space-y-6">
      <div class="flex flex-wrap gap-y-2 items-center justify-between">
        <h2 class="font-serif text-3xl font-semibold tracking-[-0.04em] text-[#17130f] dark:text-[#fff7e8]">Recent apps</h2>
      </div>
      <ul class="flex flex-col">
        {
          apps.map((app) => (
            <li>
              <ArrowCard
                entry={app}
                href={`/${app.collection}/${app.id}`}
                appIcon={app.data.appIcon}
              />
            </li>
          ))
        }
      </ul>
    </section>
  </Container>

  <!-- <section class="animate space-y-4">
        <h5 class="font-semibold text-black dark:text-white">
          Let's Connect
        </h5>
        <article>
          <p>
            If you want to get in touch with me about something or just to say hi,
            reach out on social media or send me an email.
          </p>
        </article>
        <ul class="flex flex-wrap gap-2">
          {SOCIALS.map(SOCIAL => (
            <li class="flex gap-x-2 text-nowrap">
              <Link href={SOCIAL.HREF} external aria-label={`${SITE.NAME} on ${SOCIAL.NAME}`}>
                {SOCIAL.NAME}
              </Link>
              {"/"}
            </li>
          ))}
          <li class="line-clamp-1">
            <Link href={`mailto:${SITE.EMAIL}`} aria-label={`Email ${SITE.NAME}`}>
              {SITE.EMAIL}
            </Link>
          </li>
        </ul>
      </section> -->
</PageLayout>
