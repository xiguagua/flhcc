---
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import ArrowCard from "@components/ArrowCard.astro";
import { SITE, HOME } from "@consts";
import { getPublished } from "@lib/content";

const apps = (await getPublished("apps"))
  .slice(0, SITE.NUM_PROJECTS_ON_HOMEPAGE);
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <div class="space-y-16">
      <section>
        <p class="animate mb-5 text-xs font-semibold uppercase tracking-[0.22em] text-muted">
          Independent iOS Studio // Flhcc Tech
        </p>
        <h1 class="animate font-serif text-[2.6rem] font-semibold leading-[1.08] tracking-[-0.02em] text-ink sm:text-5xl md:text-7xl md:leading-[1.05] md:tracking-[-0.035em]">
          Native tools for Apple devices.
        </h1>
        <article class="mt-10 space-y-4 text-lg leading-8 md:text-xl md:leading-9">
          <p class="animate">
            I’m an independent iOS developer and founder of <b>Flhcc Tech</b>.
          </p>
          <p class="animate">
            I build native apps for <strong>Apple devices</strong>, focusing on <strong
              >networking protocols</strong
            >, <strong>system security</strong>, and <strong
              >company equity analysis</strong
            >.
          </p>
          <p class="animate">
            Currently working on <strong>Bamboo Dragonfly</strong>.
          </p>
        </article>
      </section>
    </div>

    <section class="animate space-y-6">
      <div class="flex flex-wrap gap-y-2 items-center justify-between">
        <h2 class="font-serif text-3xl font-semibold tracking-[-0.02em] text-ink">Recent apps</h2>
      </div>
      <ul class="flex flex-col">
        {
          apps.map((app) => (
            <li>
              <ArrowCard
                entry={app}
                href={`/${app.collection}/${app.id}`}
                appIcon={app.data.appIcon}
              />
            </li>
          ))
        }
      </ul>
    </section>
  </Container>
</PageLayout>
