---
import { type CollectionEntry, render } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import { readingTime } from "@lib/utils";
import BackToPrev from "@components/BackToPrev.astro";
import { getPublished } from "@lib/content";

export async function getStaticPaths() {
  const posts = await getPublished("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}
type Props = CollectionEntry<"blog">;

const post = Astro.props;
const { Content } = await render(post);
---

<PageLayout title={post.data.title} description={post.data.description}>
  <Container>
    <div class="animate">
      <BackToPrev href="/blog">
        Back to blog
      </BackToPrev>
    </div>
    <div class="space-y-4 my-12">
      <div class="animate flex items-center gap-2 text-xs uppercase tracking-[0.18em] text-[var(--muted)] dark:text-[var(--muted)]">
        <div>
          <FormattedDate date={post.data.date} />
        </div>
        &bull;
        <div>
          {post.body && readingTime(post.body)}
        </div>
      </div>
      <h1 class="animate font-serif text-[2.35rem] font-semibold leading-[1.1] tracking-[-0.045em] text-[var(--ink)] dark:text-[var(--ink)] sm:text-5xl md:text-6xl md:leading-[1.05] md:tracking-[-0.06em]">
        {post.data.title}
      </h1>
    </div>
    <article class="animate">
      <Content />
    </article>
  </Container>
</PageLayout>
