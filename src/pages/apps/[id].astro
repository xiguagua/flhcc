---
import { getEntry, render } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import { readingTime } from "@lib/utils";
import BackToPrev from "@components/BackToPrev.astro";
import { getPublished } from "@lib/content";

export async function getStaticPaths() {
  const apps = await getPublished("apps");
  return apps.map((app) => ({
    params: { id: app.id },
  }));
}
// type Props = CollectionEntry<'apps'>;

const params = Astro.params;
const app = await getEntry("apps", params.id);
if (!app) {
  throw new Error(`Could not find ${params.id}`);
}
const { Content } = await render(app);
const appdata = app.data;

// const app = Astro.props;
---

<PageLayout title={appdata.title} description={appdata.description} image={appdata.appIcon} keywords={appdata.keywords}>
  <Container>
    <div class="animate">
      <BackToPrev href="/apps"> Back to apps </BackToPrev>
    </div>
    <div class="space-y-4 my-12">
      <div class="animate flex items-center gap-2 text-xs uppercase tracking-[0.18em] text-[#6d6257] dark:text-[#b9ab98]">
        <div>
          <FormattedDate date={appdata.date} />
        </div>
        &bull;
        <div>
          {app.body && readingTime(app.body)}
        </div>
      </div>
      <h1 class="animate font-serif text-5xl font-semibold leading-[1.05] tracking-[-0.06em] text-[#17130f] dark:text-[#fff7e8] md:text-6xl">
        {appdata.title}
      </h1>
    </div>
    <article class="animate">
      <Content />
    </article>
  </Container>
</PageLayout>
