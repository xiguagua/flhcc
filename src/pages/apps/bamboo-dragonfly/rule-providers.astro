---
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import { buildProviderLink } from "@lib/rule-provider";

import { items } from "./_items.json";

const title = "分流规则商店";

function colorIndex(initial: string): number {
  const code = initial.toUpperCase().charCodeAt(0);
  return (code * 13) % 5;
}
---

<PageLayout title={title} description={title}>
  <Container>
    <div class="flex justify-between items-center mb-8 gap-4">
        <h1 class="font-serif text-[2.1rem] font-semibold leading-[1.1] tracking-[-0.01em] text-ink sm:text-4xl sm:leading-[1.05]">分流规则商店 v1.4</h1>
        <button id="search-toggle" class="p-2 rounded-lg border border-ink/15 text-body transition-colors duration-200 hover:bg-surface-hover hover:text-accent hover:border-accent/40 active:scale-[0.95]" aria-label="Toggle Search">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-current">
                <circle cx="11" cy="11" r="8"></circle>
                <path d="m21 21-4.3-4.3"></path>
            </svg>
        </button>
    </div>
    
    <div id="search-container" class="mb-6 relative hidden">
      <div class="absolute inset-y-0 start-0 flex items-center ps-3 pointer-events-none">
        <svg class="w-4 h-4 text-muted" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 20">
            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m19 19-4-4m0-7A7 7 0 1 1 1 8a7 7 0 0 1 14 0Z"/>
        </svg>
      </div>
      <input
        type="text"
        id="search-input"
        class="block w-full py-2.5 ps-10 pe-10 text-base rounded-lg text-ink border border-ink/15 bg-transparent focus:ring-accent/35 focus:border-accent/55 dark:placeholder-muted focus:outline-none transition-colors"
        placeholder="搜索规则..."
      />
      <button
        id="search-clear"
        class="absolute inset-y-0 end-0 flex items-center pe-3 text-muted hover:text-accent transition-colors hidden"
        aria-label="Clear search"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 6 6 18"></path>
          <path d="m6 6 12 12"></path>
        </svg>
      </button>
    </div>

    <div class="flex flex-col space-y-8">
      {
        [
          { label: "World", list: items.world },
          { label: "CN", list: items.cn },
        ].map((section) => (
          <section class="provider-section">
            <h2 class="flex items-center gap-3 mb-4 text-xs font-semibold uppercase tracking-[0.22em] text-muted">
              <span class="size-1.5 rounded-full bg-accent" />
              {section.label}
              <span class="h-px flex-1 bg-ink/10" />
              <span class="tracking-normal font-normal">{section.list.length}</span>
            </h2>
            <div class="animate flex flex-col gap-3 sm:grid sm:grid-cols-3">
              {section.list.map((item) => {
                const link = buildProviderLink(item);
                return (
                  <a href={link} class="provider-card group flex" data-name={item.name.toLowerCase()}>
                    <div class="w-full h-full flex items-center justify-between gap-2 rounded-lg border-0 sm:border sm:border-ink/15 bg-white dark:bg-surface px-3.5 py-3 text-base text-body transition-colors duration-200 group-hover:bg-surface-hover group-hover:text-ink group-active:scale-[0.97] break-words">
                      <span><span class={`initial-${colorIndex(item.name.slice(0, 1))} mr-1 inline-block rounded-sm px-1 font-semibold leading-none text-white`}>{item.name.slice(0, 1)}</span>{item.name.slice(1)}</span>
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-muted opacity-0 -translate-x-1 transition-all duration-200 group-hover:opacity-100 group-hover:translate-x-0 group-hover:text-accent">
                        <path d="M5 12h14" />
                        <path d="m12 5 7 7-7 7" />
                      </svg>
                    </div>
                  </a>
                );
              })}
            </div>
          </section>
        ))
      }
    </div>
    
  </Container>
</PageLayout>

<style>
  .initial-0 { background-image: linear-gradient(to bottom, hsl(2 52% 54%), hsl(2 50% 46%)); }
  .initial-1 { background-image: linear-gradient(to bottom, hsl(36 62% 45%), hsl(36 58% 37%)); }
  .initial-2 { background-image: linear-gradient(to bottom, hsl(151 44% 39%), hsl(151 42% 32%)); }
  .initial-3 { background-image: linear-gradient(to bottom, hsl(216 55% 51%), hsl(216 52% 43%)); }
  .initial-4 { background-image: linear-gradient(to bottom, hsl(291 41% 52%), hsl(291 38% 44%)); }
</style>

<script>
  function initPage() {
    const input = document.getElementById("search-input") as HTMLInputElement;
    const container = document.getElementById("search-container");
    const toggle = document.getElementById("search-toggle");
    const clearBtn = document.getElementById("search-clear");
    const sections = document.querySelectorAll(".provider-section");

    if (toggle && container && input && clearBtn) {
      const updateSearch = () => {
        const term = input.value.toLowerCase();
        clearBtn.classList.toggle("hidden", term === "");
        
        sections.forEach(s => {
          let hasMatch = false;
          s.querySelectorAll<HTMLElement>(".provider-card").forEach(c => {
            const match = (c.dataset.name || "").includes(term);
            c.style.display = match ? "" : "none";
            if (match) hasMatch = true;
          });
          (s as HTMLElement).style.display = hasMatch ? "" : "none";
        });
      };

      toggle.onclick = (e) => {
        e.preventDefault();
        if (!container.classList.toggle("hidden")) input.focus();
      };

      clearBtn.onclick = () => {
        input.value = "";
        updateSearch();
        input.focus();
      };

      input.oninput = updateSearch;
    }

    // Desktop behavior: Copy link to clipboard
    // iPadOS Safari in "request desktop site" mode reports a plain Mac UA,
    // so also treat Macs with multi-touch as iPad (real Macs have maxTouchPoints 0)
    const ua = navigator.userAgent;
    const isIpadOs = /iPad/i.test(ua) || (/Macintosh/i.test(ua) && navigator.maxTouchPoints > 1);
    const isDesktop = !(/Mobi|Android/i.test(ua) || isIpadOs);
    if (isDesktop) {
      document.querySelectorAll<HTMLAnchorElement>(".provider-card").forEach(card => {
        card.addEventListener("click", async (e) => {
          e.preventDefault();
          try {
            await navigator.clipboard.writeText(card.href);
            const label = card.querySelector("span");
            if (label) {
              const originalHTML = label.innerHTML;
              label.textContent = "已复制链接 ✅";
              card.querySelector("div")?.classList.add("!text-green-600", "dark:!text-green-400");
              setTimeout(() => {
                label.innerHTML = originalHTML;
                card.querySelector("div")?.classList.remove("!text-green-600", "dark:!text-green-400");
              }, 800);
            }
          } catch (err) {
            console.error("Failed to copy: ", err);
          }
        });
      });
    }
  }

  document.addEventListener("astro:page-load", initPage);
</script>
