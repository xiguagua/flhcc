---
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import { buildProviderLink } from "@lib/rule-provider";

import { items } from "./_items.json";

const title = "分流规则商店";
---

<PageLayout title={title} description={title}>
  <Container>
    <div class="flex justify-between items-center mb-8 gap-4">
        <h1 class="font-serif text-[2.1rem] font-semibold leading-[1.1] tracking-[-0.045em] text-[var(--ink)] dark:text-[var(--ink)] sm:text-4xl sm:leading-[1.05] sm:tracking-[-0.06em]">分流规则商店 v1.2</h1>
        <button id="search-toggle" class="p-2 border border-[var(--ink)]/20 dark:border-[var(--ink)]/20 hover:text-[var(--ink)] dark:hover:text-[var(--ink)] transition-colors" aria-label="Toggle Search">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-current">
                <circle cx="11" cy="11" r="8"></circle>
                <path d="m21 21-4.3-4.3"></path>
            </svg>
        </button>
    </div>
    
    <div id="search-container" class="mb-6 relative hidden">
      <div class="absolute inset-y-0 start-0 flex items-center ps-3 pointer-events-none">
        <svg class="w-4 h-4 text-gray-500 dark:text-gray-400" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 20">
            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m19 19-4-4m0-7A7 7 0 1 1 1 8a7 7 0 0 1 14 0Z"/>
        </svg>
      </div>
      <input 
        type="text" 
        id="search-input" 
        class="block w-full py-2.5 ps-10 pe-10 text-base text-[var(--ink)] border border-[var(--ink)]/20 dark:border-[var(--ink)]/20 bg-[var(--surface)]/75 dark:bg-[var(--surface)]/75 focus:ring-[var(--accent)]/35 focus:border-[var(--accent)]/45 dark:focus:ring-[var(--accent)]/35 dark:focus:border-[var(--accent)]/45 dark:placeholder-[var(--muted)] dark:text-[var(--ink)] focus:outline-none transition-colors" 
        placeholder="搜索规则..." 
      />
      <button 
        id="search-clear" 
        class="absolute inset-y-0 end-0 flex items-center pe-3 text-gray-400 hover:text-black dark:hover:text-white hidden"
        aria-label="Clear search"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 6 6 18"></path>
          <path d="m6 6 12 12"></path>
        </svg>
      </button>
    </div>

    <div class="flex flex-col space-y-5">
      <div class="provider-section">
        <h2 class="text-xs font-semibold uppercase tracking-[0.22em] text-[var(--muted)] dark:text-[var(--muted)] mb-3">WORLD:</h2>
        <div class="animate grid grid-cols-2 sm:grid-cols-3 gap-3">
          {
            items.world.map((item) => {
              const link = buildProviderLink(item);
              return (
                <a href={link} class="provider-card flex" data-name={item.name.toLowerCase()}>
                  <div class="w-full h-full text-[var(--body)] dark:text-[var(--body)] border border-[var(--ink)]/18 dark:border-[var(--ink)]/18 bg-[var(--surface)]/65 dark:bg-[var(--surface)]/65 px-3 py-3 text-base break-words hover:bg-[var(--surface-hover)] dark:hover:bg-[var(--surface-hover)] active:scale-95 transform transition">
                    {item.name}
                  </div>
                </a>
              );
            })
          }
        </div>
      </div>
      <div class="provider-section">
        <h2 class="text-xs font-semibold uppercase tracking-[0.22em] text-[var(--muted)] dark:text-[var(--muted)] mb-3">CN:</h2>
        <div class="animate grid grid-cols-2 sm:grid-cols-3 gap-3">
          {
            items.cn.map((item) => {
              const link = buildProviderLink(item);
              return (
                <a href={link} class="provider-card flex" data-name={item.name.toLowerCase()}>
                  <div class="w-full h-full text-[var(--body)] dark:text-[var(--body)] border border-[var(--ink)]/18 dark:border-[var(--ink)]/18 bg-[var(--surface)]/65 dark:bg-[var(--surface)]/65 px-3 py-3 text-base break-words hover:bg-[var(--surface-hover)] dark:hover:bg-[var(--surface-hover)] active:scale-95 transform transition">
                    {item.name}
                  </div>
                </a>
              );
            })
          }
        </div>
      </div>
    </div>
    
  </Container>
</PageLayout>

<script>
  function initPage() {
    const input = document.getElementById("search-input") as HTMLInputElement;
    const container = document.getElementById("search-container");
    const toggle = document.getElementById("search-toggle");
    const clearBtn = document.getElementById("search-clear");
    const sections = document.querySelectorAll(".provider-section");

    if (toggle && container && input && clearBtn) {
      const updateSearch = () => {
        const term = input.value.toLowerCase();
        clearBtn.classList.toggle("hidden", term === "");
        
        sections.forEach(s => {
          let hasMatch = false;
          s.querySelectorAll<HTMLElement>(".provider-card").forEach(c => {
            const match = (c.dataset.name || "").includes(term);
            c.style.display = match ? "" : "none";
            if (match) hasMatch = true;
          });
          (s as HTMLElement).style.display = hasMatch ? "" : "none";
        });
      };

      toggle.onclick = (e) => {
        e.preventDefault();
        if (!container.classList.toggle("hidden")) input.focus();
      };

      clearBtn.onclick = () => {
        input.value = "";
        updateSearch();
        input.focus();
      };

      input.oninput = updateSearch;
    }

    // Desktop behavior: Copy link to clipboard
    const isDesktop = !/Mobi|Android/i.test(navigator.userAgent);
    if (isDesktop) {
      document.querySelectorAll<HTMLAnchorElement>(".provider-card").forEach(card => {
        card.addEventListener("click", async (e) => {
          e.preventDefault();
          try {
            await navigator.clipboard.writeText(card.href);
            const innerDiv = card.querySelector("div");
            if (innerDiv) {
              const originalText = innerDiv.innerText;
              innerDiv.innerText = "已复制链接 ✅";
              innerDiv.classList.add("!text-green-600", "dark:!text-green-400");
              setTimeout(() => {
                innerDiv.innerText = originalText;
                innerDiv.classList.remove("!text-green-600", "dark:!text-green-400");
              }, 800);
            }
          } catch (err) {
            console.error("Failed to copy: ", err);
          }
        });
      });
    }
  }

  document.addEventListener("astro:page-load", initPage);
</script>
